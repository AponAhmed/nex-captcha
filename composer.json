{
    "name": "bitflw/nex-captcha",
    "description": "Self-hosted, privacy-first CAPTCHA for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Bitflw",
            "homepage": "https://bitflw.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.11",
        "wp-phpunit/wp-phpunit": "^6.6"
    },
    "autoload": {
        "psr-4": {
            "Bitflw\\NexCaptcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bitflw\\NexCaptcha\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "analyse": "phpstan analyse"
    }
}
